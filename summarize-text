#!/usr/bin/env bash
# ABOUTME: AI-powered text summarization CLI tool
# ABOUTME: Summarizes text from files, URLs, clipboard, or stdin using OpenAI, Claude, or Ollama

set -euo pipefail
IFS=$'\n\t'

# Source the shared library - resolve symlinks to find actual script location
script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
	script_dir="$(cd -P "$(dirname "$script")" && pwd)"
	script="$(readlink "$script")"
	[[ $script != /* ]] && script="$script_dir/$script"
done
script_dir="$(cd -P "$(dirname "$script")" && pwd)"
# shellcheck source=./summarize-text-lib.sh
source "$script_dir/summarize-text-lib.sh"

# Script-specific configuration
cmd_base=$(basename "$0")
pre_prompt="Briefly summarize the following text in a few bullet points, preserving the original meaning. At the end, call out themes that seem pertinent or interesting."

display_help_text_and_die() {
	cat "$script_dir/docs/summarize-text-help.md"
	exit 0
}

# Handle help and version flags
if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
	display_help_text_and_die
fi
if [[ "${1:-}" == "--version" ]]; then
	echo "$cmd_base $(cat "$script_dir/VERSION" 2>/dev/null || echo "unknown")"
	exit 0
fi

# Parse command-line arguments
parse_common_arguments "$@"

# Execute processing and run the active function
execute_processing
hline "$cmd_base using $active_function"
run_ai_function
